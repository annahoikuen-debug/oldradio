{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic Color Tokens",
  "description": "Context-aware semantic color tokens referencing primitives. Supports light/dark mode.",
  "type": "object",
  "properties": {
    "color-interactive-primary": { "type": "string", "value": "{color-brand-500}" },
    "color-interactive-primary-hover": { "type": "string", "value": "{color-brand-600}" },
    "color-interactive-primary-active": { "type": "string", "value": "{color-brand-700}" },
    "color-interactive-primary-focus": { "type": "string", "value": "{color-brand-500}" },
    "color-interactive-secondary": { "type": "string", "value": "{color-gray-600}" },
    "color-interactive-secondary-hover": { "type": "string", "value": "{color-gray-700}" },
    "color-interactive-secondary-active": { "type": "string", "value": "{color-gray-800}" },
    "color-interactive-disabled": { "type": "string", "value": "{color-gray-300}" },
    "color-interactive-disabled-text": { "type": "string", "value": "{color-gray-500}" },
    "color-background-base": { "type": "string", "value": "{color-vintage-paper}" },
    "color-background-elevated": { "type": "string", "value": "#ffffff" },
    "color-background-overlay": { "type": "string", "value": "rgba(0, 0, 0, 0.5)" },
    "color-background-code": { "type": "string", "value": "{color-brand-100}" },
    "color-foreground-base": { "type": "string", "value": "#2d2d2d" },
    "color-foreground-muted": { "type": "string", "value": "{color-gray-600}" },
    "color-foreground-subtle": { "type": "string", "value": "{color-gray-500}" },
    "color-foreground-on-primary": { "type": "string", "value": "#ffffff" },
    "color-foreground-on-secondary": { "type": "string", "value": "#ffffff" },
    "color-border-base": { "type": "string", "value": "{color-brand-300}" },
    "color-border-strong": { "type": "string", "value": "{color-brand-400}" },
    "color-border-focus": { "type": "string", "value": "{color-brand-500}" },
    "color-border-error": { "type": "string", "value": "{color-error-500}" },
    "color-status-success": { "type": "string", "value": "{color-success-600}" },
    "color-status-success-bg": { "type": "string", "value": "{color-success-50}" },
    "color-status-success-border": { "type": "string", "value": "{color-success-500}" },
    "color-status-warning": { "type": "string", "value": "{color-warning-700}" },
    "color-status-warning-bg": { "type": "string", "value": "{color-warning-50}" },
    "color-status-warning-border": { "type": "string", "value": "{color-warning-500}" },
    "color-status-error": { "type": "string", "value": "{color-error-600}" },
    "color-status-error-bg": { "type": "string", "value": "{color-error-50}" },
    "color-status-error-border": { "type": "string", "value": "{color-error-500}" },
    "color-status-info": { "type": "string", "value": "{color-info-600}" },
    "color-status-info-bg": { "type": "string", "value": "{color-info-50}" },
    "color-status-info-border": { "type": "string", "value": "{color-info-500}" },
    "color-focus-ring": { "type": "string", "value": "{color-tube-glow}" },
    "color-focus-ring-offset": { "type": "string", "value": "#ffffff" }
  }
}