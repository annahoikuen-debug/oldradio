{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Navigation Component Tokens",
  "description": "Navigation component tokens - header, footer, sidebar",
  "type": "object",
  "properties": {
    "nav-header-height": { "type": "string", "value": "64px" },
    "nav-header-bg": { "type": "string", "value": "{color-background-base}" },
    "nav-header-border": { "type": "string", "value": "{color-border-base}" },
    "nav-header-padding-x": { "type": "string", "value": "{spacing-page-padding}" },
    "nav-header-padding-y": { "type": "string", "value": "{spacing-3}" },
    "nav-header-logo-font-size": { "type": "string", "value": "{font-size-xl}" },
    "nav-header-logo-font-weight": { "type": "number", "value": "{font-weight-bold}" },
    "nav-header-logo-color": { "type": "string", "value": "{color-foreground-base}" },
    "nav-header-link-font-size": { "type": "string", "value": "{font-size-base}" },
    "nav-header-link-color": { "type": "string", "value": "{color-foreground-base}" },
    "nav-header-link-color-hover": { "type": "string", "value": "{color-interactive-primary}" },
    "nav-header-link-padding-x": { "type": "string", "value": "{spacing-3}" },
    "nav-header-link-padding-y": { "type": "string", "value": "{spacing-2}" },
    "nav-header-link-border-radius": { "type": "string", "value": "6px" },
    "nav-header-link-gap": { "type": "string", "value": "{spacing-1}" },
    "nav-footer-height": { "type": "string", "value": "auto" },
    "nav-footer-bg": { "type": "string", "value": "{color-background-elevated}" },
    "nav-footer-border": { "type": "string", "value": "{color-border-base}" },
    "nav-footer-padding-x": { "type": "string", "value": "{spacing-page-padding}" },
    "nav-footer-padding-y": { "type": "string", "value": "{spacing-5}" },
    "nav-footer-text-font-size": { "type": "string", "value": "{font-size-sm}" },
    "nav-footer-text-color": { "type": "string", "value": "{color-foreground-muted}" },
    "nav-footer-link-color": { "type": "string", "value": "{color-foreground-muted}" },
    "nav-footer-link-color-hover": { "type": "string", "value": "{color-interactive-primary}" },
    "nav-sidebar-width": { "type": "string", "value": "280px" },
    "nav-sidebar-width-collapsed": { "type": "string", "value": "72px" },
    "nav-sidebar-bg": { "type": "string", "value": "{color-background-base}" },
    "nav-sidebar-border": { "type": "string", "value": "{color-border-base}" },
    "nav-sidebar-padding-x": { "type": "string", "value": "{spacing-3}" },
    "nav-sidebar-padding-y": { "type": "string", "value": "{spacing-4}" },
    "nav-sidebar-item-font-size": { "type": "string", "value": "{font-size-base}" },
    "nav-sidebar-item-color": { "type": "string", "value": "{color-foreground-base}" },
    "nav-sidebar-item-color-hover": { "type": "string", "value": "{color-interactive-primary}" },
    "nav-sidebar-item-color-active": { "type": "string", "value": "{color-interactive-primary}" },
    "nav-sidebar-item-bg-hover": { "type": "string", "value": "{color-background-elevated}" },
    "nav-sidebar-item-bg-active": { "type": "string", "value": "{color-brand-50}" },
    "nav-sidebar-item-padding-x": { "type": "string", "value": "{spacing-3}" },
    "nav-sidebar-item-padding-y": { "type": "string", "value": "{spacing-2}" },
    "nav-sidebar-item-border-radius": { "type": "string", "value": "6px" },
    "nav-sidebar-item-gap": { "type": "string", "value": "{spacing-2}" },
    "nav-sidebar-icon-size": { "type": "string", "value": "20px" },
    "nav-sidebar-transition": { "type": "string", "value": "width 0.2s ease, background-color 0.15s ease" },
    "nav-breadcrumb-font-size": { "type": "string", "value": "{font-size-sm}" },
    "nav-breadcrumb-color": { "type": "string", "value": "{color-foreground-muted}" },
    "nav-breadcrumb-separator": { "type": "string", "value": "/" },
    "nav-breadcrumb-gap": { "type": "string", "value": "{spacing-2}" },
    "nav-breadcrumb-current-color": { "type": "string", "value": "{color-foreground-base}" }
  }
}