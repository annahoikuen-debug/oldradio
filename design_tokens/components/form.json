{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Form Component Tokens",
  "description": "Form component tokens - inputs, labels, help text, validation",
  "type": "object",
  "properties": {
    "form-input-bg": { "type": "string", "value": "{color-background-base}" },
    "form-input-bg-disabled": { "type": "string", "value": "{color-background-elevated}" },
    "form-input-text": { "type": "string", "value": "{color-foreground-base}" },
    "form-input-text-disabled": { "type": "string", "value": "{color-foreground-muted}" },
    "form-input-placeholder": { "type": "string", "value": "{color-foreground-subtle}" },
    "form-input-border": { "type": "string", "value": "{color-border-base}" },
    "form-input-border-hover": { "type": "string", "value": "{color-border-strong}" },
    "form-input-border-focus": { "type": "string", "value": "{color-border-focus}" },
    "form-input-border-error": { "type": "string", "value": "{color-border-error}" },
    "form-input-padding-x": { "type": "string", "value": "{spacing-input-padding-x}" },
    "form-input-padding-y": { "type": "string", "value": "{spacing-input-padding-y}" },
    "form-input-font-size": { "type": "string", "value": "{font-size-base}" },
    "form-input-line-height": { "type": "string", "value": "{line-height-normal}" },
    "form-input-border-radius": { "type": "string", "value": "8px" },
    "form-input-transition": { "type": "string", "value": "border-color 0.15s ease, box-shadow 0.15s ease" },
    "form-input-focus-ring-width": { "type": "string", "value": "{spacing-focus-ring-width}" },
    "form-input-focus-ring-offset": { "type": "string", "value": "{spacing-focus-ring-offset}" },
    "form-input-focus-ring-color": { "type": "string", "value": "{color-focus-ring}" },
    "form-label-font-size": { "type": "string", "value": "{font-size-sm}" },
    "form-label-font-weight": { "type": "number", "value": "{font-weight-medium}" },
    "form-label-color": { "type": "string", "value": "{color-foreground-base}" },
    "form-label-gap": { "type": "string", "value": "{spacing-1}" },
    "form-help-text-font-size": { "type": "string", "value": "{font-size-sm}" },
    "form-help-text-color": { "type": "string", "value": "{color-foreground-muted}" },
    "form-help-text-gap": { "type": "string", "value": "{spacing-1}" },
    "form-error-text-font-size": { "type": "string", "value": "{font-size-sm}" },
    "form-error-text-color": { "type": "string", "value": "{color-status-error}" },
    "form-error-text-gap": { "type": "string", "value": "{spacing-1}" },
    "form-field-gap": { "type": "string", "value": "{spacing-4}" },
    "form-group-gap": { "type": "string", "value": "{spacing-5}" },
    "form-checkbox-size": { "type": "string", "value": "20px" },
    "form-checkbox-border": { "type": "string", "value": "{color-border-base}" },
    "form-checkbox-border-focus": { "type": "string", "value": "{color-border-focus}" },
    "form-checkbox-checked-bg": { "type": "string", "value": "{color-interactive-primary}" },
    "form-checkbox-checked-border": { "type": "string", "value": "{color-interactive-primary}" },
    "form-checkbox-check-color": { "type": "string", "value": "{color-foreground-on-primary}" },
    "form-radio-size": { "type": "string", "value": "20px" },
    "form-radio-border": { "type": "string", "value": "{color-border-base}" },
    "form-radio-border-focus": { "type": "string", "value": "{color-border-focus}" },
    "form-radio-checked-bg": { "type": "string", "value": "{color-interactive-primary}" },
    "form-radio-checked-border": { "type": "string", "value": "{color-interactive-primary}" },
    "form-radio-dot-color": { "type": "string", "value": "{color-foreground-on-primary}" },
    "form-select-arrow-color": { "type": "string", "value": "{color-foreground-muted}" },
    "form-select-arrow-size": { "type": "string", "value": "16px" }
  }
}