{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Button Component Tokens",
  "description": "Button component tokens - sizes, variants, states",
  "type": "object",
  "properties": {
    "button-primary-bg": { "type": "string", "value": "{color-interactive-primary}" },
    "button-primary-bg-hover": { "type": "string", "value": "{color-interactive-primary-hover}" },
    "button-primary-bg-active": { "type": "string", "value": "{color-interactive-primary-active}" },
    "button-primary-bg-disabled": { "type": "string", "value": "{color-interactive-disabled}" },
    "button-primary-text": { "type": "string", "value": "{color-foreground-on-primary}" },
    "button-primary-text-disabled": { "type": "string", "value": "{color-interactive-disabled-text}" },
    "button-primary-border": { "type": "string", "value": "transparent" },
    "button-primary-border-focus": { "type": "string", "value": "{color-focus-ring}" },
    "button-secondary-bg": { "type": "string", "value": "{color-interactive-secondary}" },
    "button-secondary-bg-hover": { "type": "string", "value": "{color-interactive-secondary-hover}" },
    "button-secondary-bg-active": { "type": "string", "value": "{color-interactive-secondary-active}" },
    "button-secondary-bg-disabled": { "type": "string", "value": "{color-interactive-disabled}" },
    "button-secondary-text": { "type": "string", "value": "{color-foreground-on-secondary}" },
    "button-secondary-text-disabled": { "type": "string", "value": "{color-interactive-disabled-text}" },
    "button-secondary-border": { "type": "string", "value": "transparent" },
    "button-secondary-border-focus": { "type": "string", "value": "{color-focus-ring}" },
    "button-ghost-bg": { "type": "string", "value": "transparent" },
    "button-ghost-bg-hover": { "type": "string", "value": "{color-background-elevated}" },
    "button-ghost-bg-active": { "type": "string", "value": "{color-background-elevated}" },
    "button-ghost-text": { "type": "string", "value": "{color-interactive-primary}" },
    "button-ghost-text-hover": { "type": "string", "value": "{color-interactive-primary-hover}" },
    "button-ghost-border": { "type": "string", "value": "transparent" },
    "button-ghost-border-focus": { "type": "string", "value": "{color-focus-ring}" },
    "button-sm-padding-x": { "type": "string", "value": "{spacing-3}" },
    "button-sm-padding-y": { "type": "string", "value": "{spacing-1}" },
    "button-sm-font-size": { "type": "string", "value": "{font-size-sm}" },
    "button-sm-border-radius": { "type": "string", "value": "6px" },
    "button-md-padding-x": { "type": "string", "value": "{spacing-4}" },
    "button-md-padding-y": { "type": "string", "value": "{spacing-2}" },
    "button-md-font-size": { "type": "string", "value": "{font-size-base}" },
    "button-md-border-radius": { "type": "string", "value": "8px" },
    "button-lg-padding-x": { "type": "string", "value": "{spacing-5}" },
    "button-lg-padding-y": { "type": "string", "value": "{spacing-3}" },
    "button-lg-font-size": { "type": "string", "value": "{font-size-lg}" },
    "button-lg-border-radius": { "type": "string", "value": "8px" },
    "button-min-height": { "type": "string", "value": "44px" },
    "button-min-width": { "type": "string", "value": "44px" },
    "button-transition": { "type": "string", "value": "background-color 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease" },
    "button-focus-ring-width": { "type": "string", "value": "{spacing-focus-ring-width}" },
    "button-focus-ring-offset": { "type": "string", "value": "{spacing-focus-ring-offset}" },
    "button-focus-ring-color": { "type": "string", "value": "{color-focus-ring}" }
  }
}