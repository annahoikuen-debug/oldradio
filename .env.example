# Retro Radio Environment Variables
# Copy this file to .env and fill in your values
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# NEVER commit .env to version control!
#
# このファイルのうち `RETRO_RADIO_` の行は retro_radio/config.py の Settings フィールドと
# 1 対 1 に対応しています（末尾の「Settings 以外で直接読む環境変数」節を除く）。
# 環境変数名は prefix "RETRO_RADIO_" + フィールド名（大文字区切り）です。
# 値の記載はコード既定値と同じです。空欄のままだら既定値が使われます。
#
# 起動: uvicorn retro_radio.server:app --host 0.0.0.0 --port 8501

# ============================================
# AI原稿生成（必須・未設定でもフォールバックで起動するが原稿品質が落ちる）
# Get from: https://aistudio.google.com/app/apikey
# 未設定時は /health が {"status": "degraded"} を返す
# ============================================
RETRO_RADIO_GEMINI_API_KEY=

# ============================================
# Application Settings（すべて任意・既定値あり）
# ============================================
RETRO_RADIO_APP_NAME=Retro Radio Time Machine
RETRO_RADIO_APP_VERSION=2.0.0
RETRO_RADIO_HOST=0.0.0.0
RETRO_RADIO_PORT=8501
RETRO_RADIO_DEBUG=false

# キャッシュ・リトライ
RETRO_RADIO_CACHE_TTL=3600
RETRO_RADIO_MAX_RETRIES=3
RETRO_RADIO_RETRY_WAIT_MIN=2
RETRO_RADIO_RETRY_WAIT_MAX=10
RETRO_RADIO_RETRY_MULTIPLIER=2

# 外部API (iTunes)
RETRO_RADIO_ITUNES_LIMIT=50
RETRO_RADIO_ITUNES_TIMEOUT_CONNECT=5
RETRO_RADIO_ITUNES_TIMEOUT_READ=10
# iTunes の候補のうち、発売年が対象年から ±N 年以内のものを採用する。
# 0 にすると発売年を気にせず候補の先頭を使う。
RETRO_RADIO_ITUNES_YEAR_TOLERANCE=1
# Apple への送客導線（アフィリエイト計測用）。
# Apple Search Ads の Affiliate Program に**登録済みのトークン**のみ
# 設定すること。未登録のものを書くと Apple 側の計測が壊れる。
# 空のままでも導線リンク自体は出る（`at` / `ct` は付かない）。
RETRO_RADIO_ITUNES_AFFILIATE_TOKEN=
RETRO_RADIO_ITUNES_AFFILIATE_CAMPAIGN=
# 「Apple Music で聴く」リンクを UI に出すか。
# Apple の規約上、プレビューを自社アプリで使う場合は Apple への
# リンクを併せて提供することが望まれる。既定は true。
RETRO_RADIO_ITUNES_SHOW_STORE_LINKS=true

# Gemini (LLM)
RETRO_RADIO_GEMINI_MODEL=gemini-3.5-flash-lite
RETRO_RADIO_GEMINI_TEMPERATURE=0.7

# TTS エンジンの選択。
#   auto = edge-tts があれば edge、無ければ gtts（既定・無償で高品質な方を自動採用）
#   edge = Microsoft Edge のニューラル音声を強制（gTTS より自然に聞こえる）
#   gtts = Google Translate の従来音声に固定（ロボット的なので非推奨）
# 設定を変えるとキャッシュキーが変わるので音声は作り直される。
RETRO_RADIO_TTS_ENGINE=auto
# edge-tts の音声 ID（日本語）。ja-JP-NanamiNeural / ja-JP-KeitaNeural / ja-JP-MasaruNeural
RETRO_RADIO_TTS_EDGE_VOICE=ja-JP-NanamiNeural
# 話速・ピッチ・音量。いずれもキャッシュキーに含まれる。
RETRO_RADIO_TTS_EDGE_RATE=+0%
RETRO_RADIO_TTS_EDGE_PITCH=+0Hz
RETRO_RADIO_TTS_EDGE_VOLUME=+0%

# TTS (gTTS。edge エンジンでは LANG / TLD / SLOW は使わない)
RETRO_RADIO_TTS_LANGUAGE=ja
RETRO_RADIO_TTS_SLOW=false
RETRO_RADIO_TTS_TLD=co.jp
# 音声キャッシュの保持日数
RETRO_RADIO_TTS_CACHE_TTL_DAYS=7
# N回の生成ごとに古い音声キャッシュを掃除する（1 = 生成のたびに掃除）
RETRO_RADIO_TTS_CACHE_SWEEP_INTERVAL=50
# CACHE_DIR 直下に保持するキャッシュファイル数の上限（CACHE-01）
RETRO_RADIO_TTS_CACHE_MAX_FILES=2000
# 乱数シード（決定論モード用。**本番では空のまま**にする）
#
# 空 = OS のエントロピーを使い、選曲順やフォールバック選択が放送ごとに変わる。
# 値（例: 42）を入れると同一入力で同一結果になるため、`eval/` の再現性検証にだけ使う。
# 本番デプロイで固定すると、全利用者・全テナント・全インスタンスで曲順が同じになる。
# このキーは**1 か所だけ**書くこと（dotenv は後勝ちで、2 回書くと下の値が勝つ）。
RETRO_RADIO_RNG_SEED=
# gTTS は短時間に連続すると 429 で弾かれるため、実呼び出しの間に空ける秒数。
# 1 回の /api/generate は「セグメント数 + 全体版」で最大 6 回直列に走る。
# 0 にすると間隔を空けず、連続して 429 になり得る。
RETRO_RADIO_TTS_MIN_INTERVAL_SECONDS=1.0
# 429 を受けたときの再試行までの待機秒数（空けずに叩くと必ず失敗する）
RETRO_RADIO_TTS_RETRY_BACKOFF_SECONDS=2.5
# 429 を受けた後、この秒数だけ gTTS の呼び出しをサーキットブレーカーで止める。
# IP 単位で恒久的に拒否されている場合、毎回 6 回叩いても取れず要求だけが遅くなる。
RETRO_RADIO_TTS_CIRCUIT_BREAKER_SECONDS=120

# --- クライアント IP の解決（R2-03: プロキシ背後のロックアウト） -----------------
# ログインの連続失敗は (メールアドレス, 送信元 IP) で記録される。
# リバースプロキシの背後で**空のまま**だと、全利用者がプロキシ 1 つの IP に
# 押し潰され、1 人の総当たりが**施設全員を 429 で締め出す**（恒久ロックアウト）。
# そのため運営者が「このヘッダーを信用する」と宣言したときだけヘッダーを読む。
#
# 未設定（空）= ヘッダーを信用せず、直結クライアントの IP を使う（安全側の既定）。
# Behind Fly.io / Render / nginx のときだけ設定すること。
# 値: x-forwarded-for（推奨） / cf-connecting-ip（Cloudflare） / 空 = 無効
RETRO_RADIO_TRUSTED_PROXY_HEADER=
# 信用するプロキシ段数 =「利用者を表すエントリが右から何番目か」（1 始まり）。
# `X-Forwarded-For: <利用者, <CDN>, ...>` の並びを前提にする。
#   nginx 1 台  = ヘッダーは利用者の 1 件だけ → 1
#   CDN + nginx = `利用者, CDN` の 2 件      → 2
# 小さすぎると攻撃者が左端を偽装でき、大きいと正当な利用者まで偽装される。
RETRO_RADIO_TRUSTED_PROXY_HOPS=1

# 年範囲
RETRO_RADIO_DEFAULT_YEAR=1975
RETRO_RADIO_MIN_YEAR=1950
RETRO_RADIO_MAX_YEAR=2025

# メドレー設定
RETRO_RADIO_MEDLEY_SONG_COUNT=3
RETRO_RADIO_TARGET_SCRIPT_CHARS=1000
RETRO_RADIO_SCRIPT_CHAR_TOLERANCE=200

# 1 回の番組（1 パス）で流す曲の下限。
# 番組は「オープニング曲 + トークN + エンディング曲」で N+1 スロットを要する。
# 1 パスのトーク数は 5 なので 6 曲。曲数が足りないとフロントが同じ曲を
# 繰り回し、1 パス内で同じ曲が 2 度流れることになる。
RETRO_RADIO_PROGRAM_MIN_SONG_COUNT=6

# 番組を何周するか（クライアントの既定値。1〜5）。
# 周回するパスごとに別々の曲を送るため、バックエンドは
# PROGRAM_LOOP_COUNT × PROGRAM_MIN_SONG_COUNT 曲を用意し `passes` で返す。
RETRO_RADIO_PROGRAM_LOOP_COUNT=3

# 選曲ローテーションと iTunes プレビュー解決結果の永続化先（SQLite）。
# 「同じ年を選んでも前回の曲と被らない」ための再生履歴をここに記録する。
# 空文字のときは DATABASE_URL と同じディレクトリに
# retro_radio_song_store.db を作る。コンテナで読み取り専用の環境では
# 書けないため、書き込み可能なボリュームをマウントすること
# （書けなくても放送は継続するが、曲の重複が増える）。
RETRO_RADIO_SONG_STORE_PATH=

# リソース保護（Gemini / gTTS / iTunes はいずれもブロッキングHTTPのため同時実行数を制限）
RETRO_RADIO_MAX_CONCURRENT_GENERATIONS=2
RETRO_RADIO_GENERATION_WAIT_TIMEOUT=30

# UI設定（SPA の静的ファイルが実際の表示を所有する。設定値はアプリ側の既定として保持される）
RETRO_RADIO_PAGE_TITLE=レトロラジオ・タイムマシン
RETRO_RADIO_PAGE_ICON=📻
RETRO_RADIO_LAYOUT=centered

# 言語設定
RETRO_RADIO_DEFAULT_LANGUAGE=ja

# CORS設定（既定は同一オリジンのみ。* にする場合は allow_credentials と併用しないこと）
# 注意: List 型の設定は既定で pydantic-settings が JSON として解析するため、
#       ここでは JSON 配列形式を推奨する（'["http://a","http://b"]'）。
#       ただし config.py の parse_cors_origins が NoDecode で意図的に緩めている。
#       そのため 'http://a,http://b'（カンマ区切り）/ '*'（単独）/ 'http://a'（単独）も
#       起動時に受理され、リストへ正規化される（* は ['*']、空文字は []）。
#       どの表記でも SettingsError にはならない。
RETRO_RADIO_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
RETRO_RADIO_CORS_ALLOW_CREDENTIALS=false

# ============================================
# Database（既定はSQLite）
# 本番は PostgreSQL:
# RETRO_RADIO_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# テーブル定義の変更は alembic upgrade head で反映する
# （Base.metadata.create_all() は既存テーブル定義を更新しない）
# ============================================
RETRO_RADIO_DATABASE_URL=sqlite:///./retro_radio.db
RETRO_RADIO_DB_POOL_RECYCLE=3600

# ============================================
# Premium TTS (ElevenLabs) — 任意
# Get from: https://elevenlabs.io/app/speech-synthesis
# 未設定時は gTTS（無料）にフォールバックする
# ============================================
RETRO_RADIO_ELEVENLABS_API_KEY=
RETRO_RADIO_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
RETRO_RADIO_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ============================================
# Stripe Settings（未設定でも起動する。checkout/webhook は 503/500 を返す）
# ============================================
RETRO_RADIO_STRIPE_SECRET_KEY=
RETRO_RADIO_STRIPE_WEBHOOK_SECRET=
RETRO_RADIO_STRIPE_PRICE_PREMIUM_MONTHLY=price_test_premium_monthly
RETRO_RADIO_STRIPE_PRICE_PREMIUM_YEARLY=price_test_premium_yearly
RETRO_RADIO_STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly
RETRO_RADIO_STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly
RETRO_RADIO_APP_URL=http://localhost:8501

# ============================================
# 認証（施設運用 readiness・提案⑧）
# ============================================
# 個人利用モードの単一ベアラーートークン。
# 画面ログインを使わない運用（自宅サーバ等）で
# `Authorization: Bearer <この値>` を要求するときにだけ意味を持つ。
# 空でも起動はできるが、RETRO_RADIO_REQUIRE_AUTH=1 のまま
# SECRET_KEY も SINGLE_USER_KEY も無いと、保護対象エンドポイントは 503 を返す
# （fail-closed）。個人利用モード（REQUIRE_AUTH=0）にすると不要になる。
# ログには絶対に出さないこと。
RETRO_RADIO_SINGLE_USER_KEY=

# `/api/generate` と `/api/audio/*` の認証要否。
#
# --- このテンプレートが出荷する既定の構成: 認証必須（安全側） ---
# コードの既定（`config.py` の `require_auth`）も 1 で、
# `docs/privacy_and_tenancy.md` / `README.md` も 1（安全側）を指示している。
# **テンプレートだけ 0 だと、指示どおりに最初のセットアップを済ませて
# 認証の無いサービスが立つ**ため、ここはコードと揃える。
RETRO_RADIO_REQUIRE_AUTH=1
#
# --- 個人利用モード: 認証なしで動かす場合 ---
# 自分の 1 台だけで使うときだけ 0 に変更する（**施設などに公開しない**）。
#   RETRO_RADIO_REQUIRE_AUTH=0
#
# --- 施設利用モード: 認証あり（本ファイルの既定） ---
# 次の 2 つを両方満たしたときだけ「起動する / 保護も効く」になる。
#   1) RETRO_RADIO_REQUIRE_AUTH=1
#   2) SECRET_KEY か SINGLE_USER_KEY のどちらかを設定する
#      （両方空だと require_secret_key() が "unavailable" を返し、
#        /api/generate と /api/audio/* が 503 になる = fail-closed）
# 鍵の生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ※ SECRET_KEY は 32 文字以上必須（短いとセッション署名の HMAC 鍵として
#   オフライン総当たりで Cookie を偽造できてしまうため `require_secret_key()`
#   が拒否する）。

# ============================================
# Session Secret（認証・セッションCookie用・施設モード）
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 空のまま起動すると起動時ログに RuntimeWarning が出る。
#   「RETRO_RADIO_SECRET_KEY が未設定です。セッション/認証関連機能は
#    利用できません（本番環境では必ず設定してください）。」
# 未設定でも /health は 200 を返す（認証済みの呼び出しでは
# secret_key_configured: false。匿名には認証フィールドを出さない）
# 本番環境では必ず設定すること（32 文字以上。短いとオフライン総当たりで
# セッション Cookie を偽造できてしまう）。
# 生成例: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================
RETRO_RADIO_SECRET_KEY=

# admin ロールとみなすメールアドレス（CSV 区切り / JSON 配列 / 単独のいずれも可）。
# 恒久的な管理権限は DB 側 users.role が正。ここは **初回デプロイ時の
# bootstrap 用**（ログイン前の管理者として当てる）。運用で交代した際は
# このリストからも外すこと。
RETRO_RADIO_ADMIN_EMAILS=

# 利用規約の版。同意記録はこの版と紐づけて保存され、
# 版を上げると全員の同意が古くなる（再同意求められる）。
RETRO_RADIO_TERMS_VERSION=1.0.0

# 同意取得の強制。1 にすると未同意の利用者は個人データを取り込む API を叩けない。
# 0 は同意記録自体を運用しない個人利用モード。
RETRO_RADIO_REQUIRE_CONSENT=false

# 論理削除の受付から完了までの運用 SLA（hours）。
# 監査ログの運用指標として /api/admin/audit で観測する。
RETRO_RADIO_DELETION_SLA_HOURS=24

# ============================================
# Settings 以外で直接読む環境変数
# （上記は config.py の Settings と 1 対 1 だが、以下は server.py が
#   os.environ から直接読むため Settings には現れない。
#   `tests/test_env_templates.py` は未知の RETRO_RADIO_ キーを弾くため、
#   ここでは有効行ではなくコメントで文書化する。
# ============================================
# Content-Security-Policy ヘッダの**完全上書き**。
# 未設定（空文字）のときは server.py 内の既定ポリシーが使われる。
# 既定ポリシーは自分の配信オリジン以外を許可しない。運用で調整したい
# ときだけ値を入れる（例: RETRO_RADIO_CSP=default-src 'self'）
# RETRO_RADIO_CSP=

# Strict-Transport-Security を出すか。1（既定）でも **HTTPS 応答のときだけ**
# 付く（平文 HTTP に返すとローカル開発を壊すため）。
# 0 / false / no / off のいずれかで無効化できる。
# RETRO_RADIO_HSTS_ENABLED=1

# HSTS の max-age（秒）。既定 31536000（1 年）。includeSubDomains は必ず付く。
# 数値以外を渡すと既定に戻る。
# RETRO_RADIO_HSTS_MAX_AGE=31536000

# 全体版（1 パス分の原稿まるごと）の TTS を生成するか。1（既定）で生成する。
# 0 にすると gTTS の呼び出しを 1 回節約できるが、レスポンスの audio_url は
# null になる（セグメント音声は従来どおり生成される）。
# RETRO_RADIO_FULL_SCRIPT_TTS=1
