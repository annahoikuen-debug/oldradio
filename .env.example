# Retro Radio Environment Variables
# Copy this file to .env and fill in your values
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# NEVER commit .env to version control!
#
# このファイルの全項目は retro_radio/config.py の Settings フィールドと 1 対 1 に対応しています。
# 環境変数名は prefix "RETRO_RADIO_" + フィールド名（大文字区切り）です。
# 値の記載はコード既定値と同じです。空欄のままだら既定値が使われます。
#
# 起動: uvicorn retro_radio.server:app --host 0.0.0.0 --port 8501

# ============================================
# AI原稿生成（必須・未設定でもフォールバックで起動するが原稿品質が落ちる）
# Get from: https://aistudio.google.com/app/apikey
# 未設定時は /health が {"status": "degraded"} を返す
# ============================================
RETRO_RADIO_GEMINI_API_KEY=

# ============================================
# Application Settings（すべて任意・既定値あり）
# ============================================
RETRO_RADIO_APP_NAME=Retro Radio Time Machine
RETRO_RADIO_APP_VERSION=2.0.0
RETRO_RADIO_HOST=0.0.0.0
RETRO_RADIO_PORT=8501
RETRO_RADIO_DEBUG=false

# キャッシュ・リトライ
RETRO_RADIO_CACHE_TTL=3600
RETRO_RADIO_MAX_RETRIES=3
RETRO_RADIO_RETRY_WAIT_MIN=2
RETRO_RADIO_RETRY_WAIT_MAX=10
RETRO_RADIO_RETRY_MULTIPLIER=2

# 外部API (iTunes)
RETRO_RADIO_ITUNES_LIMIT=50
RETRO_RADIO_ITUNES_TIMEOUT_CONNECT=5
RETRO_RADIO_ITUNES_TIMEOUT_READ=10

# Gemini (LLM)
RETRO_RADIO_GEMINI_MODEL=gemini-2.5-flash
RETRO_RADIO_GEMINI_TEMPERATURE=0.7

# TTS (gTTS)
RETRO_RADIO_TTS_LANGUAGE=ja
RETRO_RADIO_TTS_SLOW=false
RETRO_RADIO_TTS_TLD=co.jp
# 音声キャッシュの保持日数
RETRO_RADIO_TTS_CACHE_TTL_DAYS=7
# N回の生成ごとに古い音声キャッシュを掃除する（1 = 生成のたびに掃除）
RETRO_RADIO_TTS_CACHE_SWEEP_INTERVAL=50

# 年範囲
RETRO_RADIO_DEFAULT_YEAR=1975
RETRO_RADIO_MIN_YEAR=1950
RETRO_RADIO_MAX_YEAR=2025

# メドレー設定
RETRO_RADIO_MEDLEY_SONG_COUNT=3
RETRO_RADIO_TARGET_SCRIPT_CHARS=1000
RETRO_RADIO_SCRIPT_CHAR_TOLERANCE=200

# リソース保護（Gemini / gTTS / iTunes はいずれもブロッキングHTTPのため同時実行数を制限）
RETRO_RADIO_MAX_CONCURRENT_GENERATIONS=2
RETRO_RADIO_GENERATION_WAIT_TIMEOUT=30

# UI設定（SPA の静的ファイルが実際の表示を所有する。設定値はアプリ側の既定として保持される）
RETRO_RADIO_PAGE_TITLE=レトロラジオ・タイムマシン
RETRO_RADIO_PAGE_ICON=📻
RETRO_RADIO_LAYOUT=centered

# 言語設定
RETRO_RADIO_DEFAULT_LANGUAGE=ja

# CORS設定（既定は同一オリジンのみ。* にする場合は allow_credentials と併用しないこと）
# 注意: List 型の設定は既定で pydantic-settings が JSON として解析するため、
#       ここでは JSON 配列形式を推奨する（'["http://a","http://b"]'）。
#       ただし config.py の parse_cors_origins が NoDecode で意図的に緩めている。
#       そのため 'http://a,http://b'（カンマ区切り）/ '*'（単独）/ 'http://a'（単独）も
#       起動時に受理され、リストへ正規化される（* は ['*']、空文字は []）。
#       どの表記でも SettingsError にはならない。
RETRO_RADIO_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
RETRO_RADIO_CORS_ALLOW_CREDENTIALS=false

# ============================================
# Database（既定はSQLite）
# 本番は PostgreSQL:
# RETRO_RADIO_DATABASE_URL=postgresql://user:pass@host:5432/dbname
# テーブル定義の変更は alembic upgrade head で反映する
# （Base.metadata.create_all() は既存テーブル定義を更新しない）
# ============================================
RETRO_RADIO_DATABASE_URL=sqlite:///./retro_radio.db
RETRO_RADIO_DB_POOL_RECYCLE=3600

# ============================================
# Premium TTS (ElevenLabs) — 任意
# Get from: https://elevenlabs.io/app/speech-synthesis
# 未設定時は gTTS（無料）にフォールバックする
# ============================================
RETRO_RADIO_ELEVENLABS_API_KEY=
RETRO_RADIO_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
RETRO_RADIO_ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ============================================
# Stripe Settings（未設定でも起動する。checkout/webhook は 503/500 を返す）
# ============================================
RETRO_RADIO_STRIPE_SECRET_KEY=
RETRO_RADIO_STRIPE_WEBHOOK_SECRET=
RETRO_RADIO_STRIPE_PRICE_PREMIUM_MONTHLY=price_test_premium_monthly
RETRO_RADIO_STRIPE_PRICE_PREMIUM_YEARLY=price_test_premium_yearly
RETRO_RADIO_STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly
RETRO_RADIO_STRIPE_PRICE_PRO_YEARLY=price_test_pro_yearly
RETRO_RADIO_APP_URL=http://localhost:8501

# ============================================
# Session Secret（認証・セッションCookie用）
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 空のまま起動すると起動時ログに RuntimeWarning が出る。
#   「RETRO_RADIO_SECRET_KEY が未設定です。セッション/認証関連機能は
#    利用できません（本番環境では必ず設定してください）。」
# 未設定でも /health は 200 を返す（secret_key_configured: false）
# 本番環境では必ず設定すること。
# ============================================
RETRO_RADIO_SECRET_KEY=
