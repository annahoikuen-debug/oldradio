# Railway: variables that CANNOT be declared in railway.json
#
# `railway.json` (schema: https://railway.app/railway.schema.json) only accepts
# `build`, `deploy` and `environments`. There is **no `env` / `envVars` section**
# and **no `volumes` section**, so the variables below and the volume mount must
# be configured in the Railway dashboard (or with `railway add`/`railway volume`).
#
# Copy the `KEY=value` lines below into
#   Railway dashboard -> Service -> Variables
# and attach a volume mounted at /data
#   Railway dashboard -> Service -> Settings -> Volumes -> mount path /data
# (railway.json declares `"requiredMountPath": "/data"` so a deploy without the
# volume fails loudly instead of silently writing to the container layer.)
#
# Nothing below may be set to an empty string: pydantic-settings accepts "" as a
# value and does not fall back to the config.py default, so
# RETRO_RADIO_DATABASE_URL="" makes db/session.py call create_engine("") and the
# service dies on boot.

# --- required: auth mode must be explicit (never rely on the code default) ---
# true  = facility mode: browser login + session cookie from POST /api/auth/session
# false = personal mode, no auth. Never use it on a public Railway deployment.
RETRO_RADIO_REQUIRE_AUTH=true

# --- required: secret used to sign the session cookie ---
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
RETRO_RADIO_SECRET_KEY=

# --- required: SQLite on the mounted volume (4 slashes = absolute path) ---
RETRO_RADIO_DATABASE_URL=sqlite:////data/retro_radio.db
RETRO_RADIO_SONG_STORE_PATH=/data/retro_radio_song_store.db

# --- required: the public URL of the service ---
RETRO_RADIO_APP_URL=https://<your-service>.up.railway.app
RETRO_RADIO_CORS_ORIGINS=["https://<your-service>.up.railway.app"]

# --- optional: external API keys (leave unset if unused) ---
RETRO_RADIO_GEMINI_API_KEY=
RETRO_RADIO_ELEVENLABS_API_KEY=
